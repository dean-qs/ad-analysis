# Generated/resumable pipeline output -- see CLAUDE.md: "Every phase
# writes to out/ and is independently resumable." Not source, not meant
# to be versioned.
out/

# Run-specific resolution output (real page/advertiser IDs from a live
# probe) -- environment-specific, not a template. config/*.example.yaml
# stays tracked.
config/resolved_entities.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Secrets -- never committed, but guard against accidental future adds
.env
*.env
